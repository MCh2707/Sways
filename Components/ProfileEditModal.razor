@using Sways.Models
@using Sways.Services
@inject ProfileService ProfileService
@inject UserSession UserSession

@if (Show && Profile != null)
{
    <div class="modal-overlay">
        <div class="modal-content blog-modal">
            <h2>Edit Profile</h2>

            <div class="form-group">
                <label>Display Name</label>
                <input @bind="EditModel.Name" class="form-control" placeholder="Your name..." />
            </div>

            <div class="form-group">
                <label>Username</label>
                <input @bind="EditModel.Username" class="form-control" placeholder="username..." />
            </div>

            <div class="form-group">
                <label>Gender / Pronouns</label>
                <input @bind="EditModel.Gender" class="form-control" placeholder="she/her, he/him, they/them..." />
            </div>

            <div class="form-group">
                <label>About Me</label>
                <textarea @bind="EditModel.AboutMe" class="form-control long-input" placeholder="Tell us about yourself..."></textarea>
            </div>

            <h3 style="margin:16px 0 8px; color:royalblue;">Social Links</h3>

            <div class="form-group">
                <label>Twitter</label>
                <input @bind="EditModel.TwitterLink" class="form-control" placeholder="https://twitter.com/..." />
            </div>
            <div class="form-group">
                <label>Instagram</label>
                <input @bind="EditModel.InstagramLink" class="form-control" placeholder="https://instagram.com/..." />
            </div>
            <div class="form-group">
                <label>Discord</label>
                <input @bind="EditModel.DiscordLink" class="form-control" placeholder="Discord username or invite..." />
            </div>
            <div class="form-group">
                <label>Mail</label>
                <input @bind="EditModel.MailLink" class="form-control" placeholder="mailto:you@email.com" />
            </div>
            <div class="form-group">
                <label>Spotify</label>
                <input @bind="EditModel.SpotifyLink" class="form-control" placeholder="https://open.spotify.com/..." />
            </div>
            <div class="form-group">
                <label>TikTok</label>
                <input @bind="EditModel.TikTokLink" class="form-control" placeholder="https://tiktok.com/&#64;..." />
            </div>

            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                <button class="btn btn-primary" @onclick="Save">Save</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public UserAccount? Profile { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private UserAccount EditModel = new();

    protected override void OnParametersSet()
    {
        if (Show && Profile != null)
        {
            EditModel = new UserAccount
            {
                Id = Profile.Id,
                Name = Profile.Name,
                Username = Profile.Username,
                Email = Profile.Email,
                PasswordHash = Profile.PasswordHash,
                Gender = Profile.Gender,
                AboutMe = Profile.AboutMe,
                BirthDate = Profile.BirthDate,
                ProfilePicUrl = Profile.ProfilePicUrl,
                BannerUrl = Profile.BannerUrl,
                TwitterLink = Profile.TwitterLink,
                InstagramLink = Profile.InstagramLink,
                DiscordLink = Profile.DiscordLink,
                MailLink = Profile.MailLink,
                SpotifyLink = Profile.SpotifyLink,
                TikTokLink = Profile.TikTokLink,
                CreatedAt = Profile.CreatedAt
            };
        }
    }

    private async Task Save()
    {
        await ProfileService.UpdateUserProfileAsync(EditModel);
        UserSession.UpdateCurrentUser(EditModel);
        await ShowChanged.InvokeAsync(false);
        await OnSaved.InvokeAsync();
    }

    private async Task Cancel()
    {
        await ShowChanged.InvokeAsync(false);
    }
}
