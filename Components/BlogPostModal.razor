@using Sways.Models
@using Sways.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ProfileService ProfileService
@inject IJSRuntime JS

@if (Show)
{
    <div class="modal-overlay">
        <div class="modal-content blog-modal">
            <h2>@(IsEditMode ? "Edit Blog Post" : "Add Blog Post")</h2>

            <div class="form-group">
                <label>Blog Title</label>
                <input @bind="EditModel.Title" class="form-control" placeholder="Enter blog title..." />
            </div>

            <div class="form-group">
                <label>Content</label>
                <textarea @bind="EditModel.Content" class="form-control long-input" placeholder="Write your daily blog..."></textarea>
            </div>

            <div class="form-group">
                <label>Additional Info <span style="color:#999">(Max 100 characters)</span></label>
                <input @bind="EditModel.MediaInfo" maxlength="100" class="form-control" placeholder="Additional info..." />
            </div>

            <div class="form-group">
                <label>Visibility</label>
                <select @bind="EditModel.Visibility" class="form-control">
                    <option value="Public">Public</option>
                    <option value="Saved">Saved (only you)</option>
                    <option value="Link">Link only</option>
                </select>
            </div>

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <p style="color:red">@errorMsg</p>
            }

            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                <button class="btn btn-primary" @onclick="Upload">@(IsEditMode ? "Save Changes" : "Upload")</button>
                @if (IsEditMode)
                {
                    <button class="btn btn-danger" @onclick="DeletePost" style="background:red;color:white;padding:10px 20px;border-radius:10px;margin-left:10px;">Delete</button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public BlogPost Post { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public bool IsEditMode { get; set; }

    private BlogPost EditModel = new();
    private string errorMsg = "";

    protected override void OnParametersSet()
    {
        if (Show)
        {
            EditModel = new BlogPost
            {
                Id = Post.Id,
                UserId = Post.UserId,
                Title = Post.Title,
                Content = Post.Content,
                MediaInfo = Post.MediaInfo,
                MediaFilePath = Post.MediaFilePath,
                DatePosted = Post.DatePosted,
                LastEdited = Post.LastEdited,
                Visibility = string.IsNullOrEmpty(Post.Visibility) ? "Public" : Post.Visibility
            };
            errorMsg = "";
        }
    }

    private async Task Upload()
    {
        if (string.IsNullOrWhiteSpace(EditModel.Title))
        {
            errorMsg = "Please enter a title.";
            return;
        }

        if (IsEditMode)
            await ProfileService.UpdateBlogPostAsync(EditModel);
        else
            await ProfileService.AddBlogPostAsync(EditModel);

        await ShowChanged.InvokeAsync(false);
        await OnSaved.InvokeAsync();
    }

    private async Task DeletePost()
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this post?");
        if (confirm)
        {
            await ProfileService.DeleteBlogPostAsync(EditModel.Id);
            await ShowChanged.InvokeAsync(false);
            await OnSaved.InvokeAsync();
        }
    }

    private async Task Cancel()
    {
        await ShowChanged.InvokeAsync(false);
    }
}
